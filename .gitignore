# --- Node / Electron build ---
node_modules
dist
out
release
.DS_Store
.eslintcache
*.log*
.vite/

# --- Editors / OS ---
.idea
*.swp
Thumbs.db

# --- Data-leak guards (Risk 4: PHI must never enter the repo) ---
# Local analytics/metadata databases created by the app at runtime.
*.duckdb
*.duckdb.wal
*.db
*.db-journal
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# Electron userData / app data (backups, logs, caches).
userData/

# Environment files that may hold connector credentials.
.env
.env.*
!.env.example

# Raw EDI files that may contain PHI — never commit real 835/837s.
# Negated below for sample-data/ ONLY: those are hand-built synthetic
# fixtures, never real payer/patient data (see CONTRIBUTING.md's data
# policy) — everywhere else, *.835/*.837 stay blocked.
*.835
*.837
!sample-data/*.835
!sample-data/*.837

# Dedicated scratch directory for real files during local development.
# (sample-data/ holds only synthetic fixtures and IS committed.)
local-data/

# Shared server (Phase 3 chunk E) — its data dir (analytics.duckdb,
# meta.db, users.db, uploaded files, backups) and generated JWT secret
# never belong in the repo, same rationale as userData/ above.
server-data/
jwt-secret.txt

# Secret-scan tool caches.
.gitleaks-report.json

# Claude session history (local only)
.remember/
