{
  "name": "aethera-reports",
  "version": "0.2.0",
  "description": "Local-first RCM client reporting & analytics desktop app (Electron + DuckDB).",
  "main": "./out/main/index.js",
  "license": "Apache-2.0",
  "author": "Aethera Healthcare",
  "homepage": "https://github.com/kk078/aethera-reports#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kk078/aethera-reports.git"
  },
  "bugs": {
    "url": "https://github.com/kk078/aethera-reports/issues"
  },
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "lint:secrets": "bash scripts/lint-secrets.sh",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck:portal": "tsc --noEmit -p portal/tsconfig.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web && npm run typecheck:portal",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win nsis msi",
    "build:mac": "electron-vite build && electron-builder --mac",
    "build:linux": "electron-vite build && electron-builder --linux",
    "e2e:import-check": "vite-node scripts/e2e-import-check.ts",
    "e2e:generate-check": "vite-node scripts/e2e-generate-check.ts",
    "e2e:connector-sync": "vite-node scripts/e2e-connector-sync.ts",
    "e2e:watch-folder": "vite-node scripts/e2e-watch-folder.ts",
    "crosscheck:rcm": "vite-node scripts/crosscheck-rcm.ts",
    "cli": "vite-node src/main/cli-entry.ts --",
    "server": "vite-node server/src/index.ts",
    "server:user": "vite-node server/src/cli.ts --",
    "e2e:server-mode": "vite-node scripts/e2e-server-mode.ts",
    "e2e:portal": "vite-node scripts/e2e-portal.ts",
    "generate:icons": "vite-node scripts/generate-icons.ts"
  },
  "dependencies": {
    "@duckdb/node-api": "1.5.5-r.4",
    "@electron-toolkit/utils": "^4.0.0",
    "@fastify/jwt": "^10.2.2",
    "@fastify/multipart": "^10.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/roboto": "^5.3.0",
    "@material-symbols/font-400": "^0.47.0",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "13.0.3",
    "chokidar": "^5.0.0",
    "echarts": "^6.1.0",
    "exceljs": "^4.4.0",
    "fastify": "^5.12.1",
    "fastify-plugin": "^6.0.0",
    "hono": "^4.13.5",
    "nodemailer": "^9.0.6",
    "papaparse": "^5.7.0",
    "pptxgenjs": "^4.0.1",
    "react-router-dom": "^7.18.2",
    "vite": "^7.2.6",
    "vite-node": "^6.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260828.1",
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.19.1",
    "@types/nodemailer": "^6.4.24",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "electron": "39.8.10",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "jszip": "^3.10.1",
    "png2icons": "^2.0.1",
    "prettier": "^3.7.4",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "sharp": "^0.35.4",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11",
    "wrangler": "^4.127.0"
  }
}
