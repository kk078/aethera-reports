# Copy to portal/.env (gitignored) — wrangler reads these automatically.
# Per the user's account conventions: a per-project scoped API token,
# never a global `wrangler login`.
CLOUDFLARE_ACCOUNT_ID=replace-with-your-cloudflare-account-id
CLOUDFLARE_API_TOKEN=replace-with-a-scoped-api-token-for-this-project-only
